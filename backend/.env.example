# 백엔드 실행용 환경 변수. 이 파일을 backend/.env 로 복사한 뒤 값을 채우세요.
#   cd backend && cp .env.example .env
# .env 는 .gitignore 로 제외됩니다. 절대 커밋하지 마세요. 실제 값은 팀 채널에서 받습니다.
# 같은 .env 를 compose.yaml(로컬 컨테이너)과 Spring(application.yaml)이 함께 읽습니다.

# ── PostgreSQL ─────────────────────────────────────────────
# 로컬: compose.yaml 이 이 값으로 컨테이너를 만든다. 비밀번호는 아무 값이나 정하면 된다
DB_NAME=zigzaego
DB_USERNAME=zigzaego
DB_PASSWORD=
# 스테이징 · 운영에서만 주석을 풀고 채운다. 로컬은 compose 가 자동 연결한다
# DB_URL=jdbc:postgresql://<host>:5432/<db>

# ── Redis (refresh token 저장, ADR-0005) ────────────────────
# 스테이징 · 운영에서만 주석을 풀고 채운다. 로컬은 compose 가 자동 연결한다
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── JWT (ADR-0005) ─────────────────────────────────────────
# HS256 서명 키. 256비트(32바이트) 이상 랜덤 값. 짧으면 서버가 뜨지 않는다. 생성 예: openssl rand -base64 32
JWT_SECRET=
# access token 만료. Duration 형식(30m · 1h). 주석 상태면 30m
# JWT_ACCESS_TTL=30m
# refresh token 만료 = Redis TTL. 주석 상태면 14d
# JWT_REFRESH_TTL=14d

# ── CORS (docs/API.md 5절) ─────────────────────────────────
# 쉼표 구분. 주석 상태면 http://localhost:3000
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── job 실행기 (지라 S15P31A308-92) ──────────────────────────
# 오래 걸리는 작업(온보딩 분석 · 영수증 인식)을 동시에 몇 개 돌릴지. 주석 상태면 4
# JOB_EXECUTOR_POOL_SIZE=4

# ── Apify 네이버 플레이스 수집 (지라 S15P31A308-94, 설계 1.1) ──────
# 팀 Apify 계정의 API 토큰 (Settings → API & Integrations). 비우면 가게 검색 · 메뉴 수집만 503
APIFY_TOKEN=
# 테스트용으로 다른 주소를 쓸 때만. 주석 상태면 https://api.apify.com
# APIFY_BASE_URL=https://api.apify.com

# ── GMS LLM (지라 S15P31A308-93, 온보딩 메뉴 구성 추출 · 재료 분류) ──────
# SSAFY 가 준 GMS API 키. 비우면 온보딩 분석 job 만 LLM_UNAVAILABLE 로 실패한다
GMS_KEY=
# OpenAI 호환 주소 (뒤에 /chat/completions 가 붙는다). 팀 채널에서 받는다
GMS_BASE_URL=
# 모델 이름. 팀 채널에서 받는다
GMS_MODEL=

# ── CLOVA General OCR (지라 S15P31A308-111, 영수증 글자 인식 · DECISIONS #32) ──────
# 둘 중 하나라도 비우면 가짜 글자 인식(정해진 영수증 글자)을 쓴다. 영수증 job 의 ocr_json 에 "fake": true 가 남는다
# General OCR 도메인의 APIGW Invoke URL 전체. 팀 채널에서 받는다
CLOVA_OCR_URL=
# 그 도메인의 Secret Key (요청 헤더 X-OCR-SECRET)
CLOVA_OCR_SECRET=
# 올린 영수증 원본을 둘 폴더. 주석 상태면 ./data/receipts (스테이징 · 운영은 /data 볼륨 아래)
# RECEIPT_STORAGE_DIR=./data/receipts
# 영수증 원본 저장소: file(기본) · s3. s3 는 운영용이고 RECEIPT_S3_BUCKET · AWS_REGION 이 필요하다(ADR-0013)
# RECEIPT_STORAGE=file
# RECEIPT_S3_BUCKET=
# RECEIPT_S3_ENDPOINT=
# CLOVA 키가 없을 때(가짜 글자 인식) 영수증 올리기 · 다시 읽기를 열지. 기본 false — 닫혀 있으면 503 RECEIPT_OCR_NOT_CONFIGURED.
# 로컬 개발 · FE 연결 시험에서만 true. 스테이징 · 운영에서 켜면 사장님 화면에 가짜 품목이 뜬다
# RECEIPT_ALLOW_FAKE_OCR=true

# ── 초기 계정 만들기 (지라 S15P31A308-37) ───────────────────
# create-account 프로필로 실행할 때만 읽는다. 실행법은 README "계정 만들기". 만든 뒤 비밀번호 줄은 지운다
# CREATE_ACCOUNT_EMAIL=
# CREATE_ACCOUNT_PASSWORD=
# CREATE_ACCOUNT_OWNER_NAME=
# CREATE_ACCOUNT_STORE_NAME=
# 화면에 보일 가게 이름. 주석 상태면 STORE_NAME 과 같다
# CREATE_ACCOUNT_STORE_DISPLAY_NAME=
# 주석 상태면 Asia/Seoul
# CREATE_ACCOUNT_TIMEZONE=Asia/Seoul

# ── Apify 네이버 플레이스 수집 (지라 S15P31A308-94, 설계 1.1) ──────
# 팀 Apify 계정의 API 토큰 (Settings → API & Integrations). 비우면 가게 검색 · 메뉴 수집만 503
APIFY_TOKEN=
# 테스트용으로 다른 주소를 쓸 때만. 주석 상태면 https://api.apify.com
# APIFY_BASE_URL=https://api.apify.com

# ── 식자재몰 시세 · 라벨 적재 (지라 S15P31A308-232 · 229, ADR-0010 · ADR-0012) ───────────────
# import-market-products 프로필로 실행할 때만 읽는다. 실행법은 README "식자재몰 시세 적재". 둘 중 하나는 있어야 한다
# 크롤러 scripts/export_market_csv.py 가 만든 CSV 의 경로. 파일에 든 수집일의 줄만 지우고 다시 넣는다(다른 날짜는 쌓여 일별 추이가 된다)
# MARKET_PRODUCTS_FILE=
# ai/scripts/market/classify_products.py 가 만든 라벨 CSV(labels.csv) 경로. 상품명 기준으로 덮어쓴다 (실험용. 운영 라벨은 아래 배치가 만든다)
# MARKET_LABELS_FILE=
# 시세를 넣고 나면 같은 실행에서 상품명 라벨 배치(Spring Batch, ADR-0014)가 돈다 — GMS_KEY · GMS_BASE_URL · GMS_MODEL 이 필요하고, 비어 있으면 건너뛴다
# 한 번 실행에 분류할 상품명 상한. 주석 상태면 0 = 라벨 없는 후보 전부(10/31 데이터셋 기준 약 10만 개 · 요청 2,600번). 비용 확인 · 나눠 돌리기용
# MARKET_LABEL_LIMIT=0
# 라벨 버전. 프롬프트(backend/src/main/resources/market/item_group.md) · 품목군 표 · 모델을 바꾸면 올린다 — 이전 버전 라벨은 다시 분류한다. 주석 상태면 v2
# MARKET_LABEL_VERSION=v2
# 동시에 보내는 LLM 요청 수. 주석 상태면 8 (한 요청 약 30초 → 후보 10만 개 · 요청 2,650번이 약 3시간). 한도 429 가 잦으면 줄인다
# MARKET_LABEL_THREADS=8
# 라벨 표 CSV 백업 폴더. chunk 커밋마다 labels_latest.csv, 단계 끝에 labels_<시각>.csv. 주석 상태면 ./data/market-labels (gitignore). 비우면 백업 안 함
# MARKET_LABEL_BACKUP_DIR=./data/market-labels

# ── 재료 카테고리 자동 분류 (지라 S15P31A308-274) ──────────────────
# 재료가 생길 때 이름으로 카테고리를 정한다: 백업 파일 → 재료표 · 품목군 표 매핑 → LLM(GMS_MODEL) → 기타. GMS 가 비어 있으면 표에 없는 재료는 기타
# LLM 한 요청을 기다리는 상한. 넘기면 기타로 두고 재료 생성은 성공한다. 주석 상태면 20s
# INGREDIENT_CATEGORY_LLM_TIMEOUT=20s
# 분류 결과 CSV 백업 폴더. 자동 분류 · auto-assign 뒤 ingredient_categories_latest.csv 갱신, 자동 분류가 먼저 읽는다. 주석 상태면 ./data/ingredient-categories (gitignore). 비우면 백업 · 되살리기 안 함
# INGREDIENT_CATEGORY_BACKUP_DIR=./data/ingredient-categories

# ── 추천 생성 배치 (지라 S15P31A308-63, 설계 5절) ──────────────────
# 매일 추천을 만드는 시각. Spring cron 6자리(초 분 시 일 월 요일). 주석 상태면 04:00 (ai-batch 03:00 뒤)
# RECOMMENDATION_CRON=0 0 4 * * *
# 그 시각의 시간대. 주석 상태면 Asia/Seoul
# RECOMMENDATION_ZONE=Asia/Seoul

# ── 도착 예정일 자동 입고 배치 (지라 S15P31A308-203) ──────────────────
# 보낸 발주의 예정일이 지난(전날까지) 줄을 주문 수량대로 입고 처리하는 시각. Spring cron 6자리. 주석 상태면 00:10
# RECEIVING_AUTO_CRON=0 10 0 * * *
# 그 시각의 시간대. "오늘" 은 가게마다 그 가게 시간대로 판단한다. 주석 상태면 Asia/Seoul
# RECEIVING_AUTO_ZONE=Asia/Seoul

# ── 마감 확인 웹 푸시 (지라 S15P31A308-247 · 248, DECISIONS #88) ──────────────────
# VAPID 키 쌍. 셋 중 하나라도 비우면 앱은 뜨고 마감 알림만 건너뛴다(로그 1줄). 만들기: npx web-push generate-vapid-keys
# 공개키(base64url) — FE 의 NEXT_PUBLIC_VAPID_PUBLIC_KEY 와 같은 값
VAPID_PUBLIC_KEY=
# 개인키(base64url). 비밀값 — 팀 채널에서 받는다
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 주소 (mailto:팀 메일)
VAPID_SUBJECT=
# 마감 시각이 지났는지 보는 주기. Spring cron 6자리. 주석 상태면 5분마다
# PUSH_CLOSING_CRON=0 */5 * * * *
# 그 시각의 시간대. 마감 시각 판단은 가게마다 store.timezone. 주석 상태면 Asia/Seoul
# PUSH_CLOSING_ZONE=Asia/Seoul
# ── 운영자용 온보딩 저장본 (지라 S15P31A308-321, ADR-0016) ───────────────
# 시연 검색어의 가게 찾기 · 메뉴 수집 결과를 미리 받아 저장 · 지울 때 쓴다. 실행법은 backend/README.md "온보딩 저장본". 비우면 실행이 멈춘다
# ONBOARDING_REPLAY_QUERY=위글리 파스타볼
# ── 시연 계정 (지라 S15P31A308-337, ADR-0018) ──────────────────────
# 이 이메일은 이미 가입돼 있어도 POST /auth/signup 이 다시 된다 (옛 계정은 이메일만 보관용으로 바뀌고 남는다). 비우면 쓰지 않는다
# DEMO_ACCOUNT_EMAIL=
# 시연 계정의 가게가 보는 오늘 (ADR-0019, YYYY-MM-DD). 주석 상태면 2026-11-12. DEMO_ACCOUNT_EMAIL 이 비면 쓰지 않는다
# DEMO_ACCOUNT_TODAY=2026-11-12
# 저장본으로 답할 때 기다리는 시간 (Duration 형식). 주석 상태면 가게 찾기 4초 · 분석 15초, 0s 면 바로 답한다
# ONBOARDING_REPLAY_SEARCH_DELAY=4s
# ONBOARDING_REPLAY_ANALYSIS_DELAY=15s
