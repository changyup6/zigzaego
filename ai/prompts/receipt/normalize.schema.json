{
  "type": "object",
  "description": "영수증 한 장의 거래처 · 날짜 · 품목 줄. 합계 · 세금 · 할인 · 포인트 줄은 넣지 않는다.",
  "properties": {
    "supplier": {
      "type": ["string", "null"],
      "description": "발행한 가게 이름. 없으면 null"
    },
    "date": {
      "type": ["string", "null"],
      "description": "판매일 YYYY-MM-DD. 없으면 null"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "영수증에 보이는 그대로의 상품명 (순번 · 기호 · 바코드 제외)"
          },
          "unit": {
            "type": ["string", "null"],
            "description": "상품명 끝 포장 단위(팩 · 봉 · 단 · 개 ...). 없으면 null"
          },
          "qty": {
            "type": ["number", "null"],
            "description": "수량"
          },
          "price": {
            "type": ["number", "null"],
            "description": "단가"
          },
          "amount": {
            "type": ["number", "null"],
            "description": "금액(할인 전)"
          }
        },
        "required": ["name", "unit", "qty", "price", "amount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["supplier", "date", "items"],
  "additionalProperties": false
}
