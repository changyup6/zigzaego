# 편집기 공통 형식 (S15P31A308-315). IntelliJ · VS Code 가 그대로 읽는다.
# 백엔드 Java 는 ./gradlew spotlessCheck 가 import 순서 · 줄 끝 공백 · 파일 끝 줄바꿈을 검사한다 (backend/build.gradle).
# 줄 끝(LF · CRLF)은 .gitattributes 가 정한다.
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120
trim_trailing_whitespace = true

[*.gradle]
indent_style = tab
indent_size = 4
tab_width = 4
